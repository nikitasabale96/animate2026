              alt="Manipal Bangalore Campus"
              decoding="async"
              class="max-h-16 w-auto object-contain"
            />
          </a>
        </div>
      </div> -->

      <!-- Other Partners Grid -->
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        
        

        <!-- Execution Partner -->
        <!-- <div class="flex flex-col rounded-xl border border-gray-100 bg-white p-6 text-center shadow-sm">
          <h3 class="mb-6 text-lg font-bold text-[#800000ff]">
            Execution Partner
          </h3>
          <div class="my-auto flex items-center justify-center">
            <a
              href="https://www.whistlingwoods.net/"
              target="_blank"
              rel="noopener noreferrer"
              class="transition-transform duration-200 hover:scale-105"
            >
              <img
                src={newlogo.src}
                alt="Whistling Woods International"
