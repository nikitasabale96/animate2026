              href="https://www.iitb.ac.in/"
              target="_blank"
              rel="noopener noreferrer"
              class="transition-transform duration-200 hover:scale-105"
            >
              <img
                src={iit.src}
                alt="IIT Bombay"
                decoding="async"
                class="max-h-17 w-auto object-contain"
              />
            </a>
          </div>
        </div>
        <!-- Resource Partner -->
        <div class="flex flex-col rounded-xl border border-green-300 bg-white p-6 text-center shadow-sm">
