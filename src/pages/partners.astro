---
import Main from '../layouts/main.astro';
import focal from '../images/focal.png';
import spoken from '../images/spoken.png';
import srishti from '../images/srishti-manipal-logo.png';
import manipal from '../images/manipal-logo.png';
import mbc from '../images/manipal-bangalore-camp.png';
import newlogo from '../images/WWI New Logo (Black).png';
---

<Main>
  <section id="partner" class="bg-white py-12">
    <div class="mx-auto max-w-6xl px-6">
      
      <!-- Knowledge Partner Heading -->
      <div class="mb-6 text-center">
        <h2 class="text-2xl font-bold text-[#800000ff] sm:text-3xl">
          Knowledge Partner
        </h2>
        <p class="mt-1 text-sm font-medium text-gray-600 sm:text-base">
          Design Led Innovation Program, Srishti Manipal Institute, MAHE - Bangalore
        </p>
      </div>

      <!-- Knowledge Partner Card -->
      <div class="mb-12 rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
        <div class="grid grid-cols-1 items-center justify-items-center gap-6 sm:grid-cols-3">
          <a
            href="https://srishtimanipalinstitute.in/"
            target="_blank"
            rel="noopener noreferrer"
            class="transition-transform duration-200 hover:scale-105"
          >
            <img
              src={srishti.src}
              alt="Srishti Manipal Institute"
              decoding="async"
              class="max-h-16 w-auto object-contain"
            />
          </a>

          <a
            href="https://www.manipal.edu/mu.html"
            target="_blank"
            rel="noopener noreferrer"
            class="transition-transform duration-200 hover:scale-105"
          >
            <img
              src={manipal.src}
              alt="Manipal Academy of Higher Education"
              decoding="async"
              class="max-h-16 w-auto object-contain"
            />
          </a>

          <a
            href="https://www.manipal.edu/mu.html"
            target="_blank"
            rel="noopener noreferrer"
            class="transition-transform duration-200 hover:scale-105"
          >
            <img
              src={mbc.src}
              alt="Manipal Bangalore Campus"
              decoding="async"
              class="max-h-16 w-auto object-contain"
            />
          </a>
        </div>
      </div>

      <!-- Other Partners Grid -->
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        
        <!-- Resource Partner -->
        <div class="flex flex-col rounded-xl border border-gray-100 bg-white p-6 text-center shadow-sm">
          <h3 class="mb-6 text-lg font-bold text-[#800000ff]">
            Resource Partner
          </h3>
          <div class="my-auto flex items-center justify-center">
            <a
              href="https://focal.fossee.in"
              target="_blank"
              rel="noopener noreferrer"
              class="transition-transform duration-200 hover:scale-105"
            >
              <img
                src={focal.src}
                alt="FOCAL Resource Partner"
                decoding="async"
                class="max-h-16 w-auto object-contain"
              />
            </a>
          </div>
        </div>

        <!-- Execution Partner -->
        <div class="flex flex-col rounded-xl border border-gray-100 bg-white p-6 text-center shadow-sm">
          <h3 class="mb-6 text-lg font-bold text-[#800000ff]">
            Execution Partner
          </h3>
          <div class="my-auto flex items-center justify-center">
            <a
              href="https://www.whistlingwoods.net/"
              target="_blank"
              rel="noopener noreferrer"
              class="transition-transform duration-200 hover:scale-105"
            >
              <img
                src={newlogo.src}
                alt="Whistling Woods International"
                decoding="async"
                class="max-h-16 w-auto object-contain"
              />
            </a>
          </div>
        </div>

        <!-- Learning Partner -->
        <div class="flex flex-col rounded-xl border border-gray-100 bg-white p-6 text-center shadow-sm">
          <h3 class="mb-6 text-lg font-bold text-[#800000ff]">
            Learning Partner
          </h3>
          <div class="my-auto flex items-center justify-center">
            <a
              href="https://spoken-tutorial.org/"
              target="_blank"
              rel="noopener noreferrer"
              class="transition-transform duration-200 hover:scale-105"
            >
              <img
                src={spoken.src}
                alt="Spoken Tutorial"
                decoding="async"
                class="max-h-16 w-auto object-contain"
              />
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>
</Main>