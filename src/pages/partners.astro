            <a
              href="https://focal.fossee.in"
              target="_blank"
              rel="noopener noreferrer"
              class="transition-transform duration-200 hover:scale-105"
            >
              <img
                src={focal.src}
                alt="FOCAL Resource Partner"
                decoding="async"
                class="max-h-17 w-auto object-contain"
              />
            </a>
          </div>
        </div>
        <!-- Learning Partner -->
        <div class="flex flex-col rounded-xl border border-green-300 bg-white p-6 text-center shadow-sm">
          <h3 class="mb-6 text-lg font-bold text-[#800000ff]">
            Learning Partner
          </h3>
          <div class="my-auto flex items-center justify-center">
            <a
              href="https://spoken-tutorial.org/"
              target="_blank"
              rel="noopener noreferrer"
              class="transition-transform duration-200 hover:scale-105"
            >
              <img
                src={spoken.src}
                alt="Spoken Tutorial"
