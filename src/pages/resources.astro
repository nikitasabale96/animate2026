---
import Main from '../layouts/main.astro';
---

<Main>
  <section id="resources" class="bg-white py-12">
    <div class="mx-auto max-w-6xl px-6">
      
      <!-- Section Header -->
      <div class="mb-10 text-center">
       <h2 class="text-3xl font-bold text-center text-[#800000ff] mb-8">
          Helpful Resources for the Hackathon
        </h2>
        <p class="mx-auto mt-4 max-w-2xl  text-xl text-gray-600">
          The following resources will help you learn the required open-source
          software and prepare your submission for <strong>ANIMATE 2026</strong>.
        </p>
      </div>

      <!-- Resource Cards Grid -->
      <div class="grid gap-6 md:grid-cols-2">
        
        <!-- Spoken Tutorials -->
        <div class="rounded-xl border border-green-300 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
          <h3 class="mb-3 text-xl font-semibold text-[#800000ff]">
            🎓 Spoken Tutorials
          </h3>
          <p class="mb-4 text-xl  text-gray-700">
            Learn <strong>Blender</strong> and <strong>Synfig Studio</strong>
            through 
            <a 
                href="https://spoken-tutorial.org/tutorial-search/?search_foss=Synfig&search_language=English" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="font-medium text-blue-600 hover:underline"
              >
                Spoken Tutorials
              </a>
              . Tutorials are available in:
          </p>
          <p class="font-medium text-xl text-gray-800">
            English, Hindi, Kannada, Marathi, Malayalam, Tamil, and Telugu.
          </p>
        </div>

        <!-- Supporting Tools -->
        <div class="rounded-xl border border-green-300 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
          <h3 class="mb-3 text-xl font-semibold text-[#800000ff]">
            🛠 Supporting Open-Source Tools
          </h3>
          <p class="mb-4 text-xl text-gray-700">
            For graphics, audio, and video editing, you may use:
          </p>
          <ul class="list-disc  text-xl space-y-2 pl-5 text-gray-700">
           <li> <a 
                href="https://www.gimp.org/" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="font-medium text-blue-600 hover:underline"
              >
                GIMP
              </a></li>
            <li> <a 
                href="https://inkscape.org/" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="font-medium text-blue-600 hover:underline"
              >
                  Inkscape</a>
                  </li>
                 <li> <a 
                href="https://www.audacityteam.org/" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="font-medium text-blue-600 hover:underline"
              >
                Audacity
              </a>
              </li>
              <li> <a 
                href="https://www.openshot.org/" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="font-medium text-blue-600 hover:underline"
              >
                OpenShot Video Editor
              </a>
           </li>
          </ul>
          <p class="mt-4  text-xl text-sm text-gray-600">
            Spoken Tutorials for these tools are also available in multiple Indian languages.
          </p>
        </div>

        <!-- Installation Help -->
        <div class="rounded-xl border border-green-300 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
          <h3 class="mb-3 text-xl font-semibold text-[#800000ff]">
            💻 Installation Guides
          </h3>
          <ul class="space-y-3  text-xl text-gray-700">
            <li>
              🔗
              <a 
                href="https://www.synfig.org/" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="font-medium text-blue-600 hover:underline"
              >
                Install Synfig Studio
              </a>
            </li>
            <li>
              🔗
              <a 
                href="https://www.blender.org/" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="font-medium text-blue-600 hover:underline"
              >
                Install Blender
              </a>
            </li>
          </ul>
        </div>

        <!-- Additional Resources -->
        <div class="rounded-xl border border-green-300 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
          <h3 class="mb-3 text-xl font-semibold text-[#800000ff]">
            📚 Additional Learning Resources
          </h3>
          <ul class="list-disc text-xl space-y-3 pl-5 text-gray-700">
            <li>
              Learn script writing and storytelling through
              <a 
                href="https://spoken-tutorial.org/tutorial-search/?search_foss=Communication+Series&search_language=English" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="font-medium text-blue-600 hover:underline"
              >
                        Communication Spoken Tutorials          
                 </a>
            </li>
            <li>
              Explore graphics and creative assets from the
              <a 
                href="https://www.focal.fossee.in/"
                target="_blank" 
                rel="noopener noreferrer" 
                class="font-medium text-blue-600 hover:underline"
              >
              FOCAL (Free and Open Source Creative Art Library)
                 </a>
              repository.
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>
</Main>