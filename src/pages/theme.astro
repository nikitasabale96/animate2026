---
import Main from '../layouts/main.astro';
import theme from '../images/theme.png';
---

<Main>
  <section id="themes" class="bg-white py-12">
    <div class="mx-auto max-w-7xl px-6">
      
      <!-- Section Heading -->
      <h2 class="text-3xl font-bold text-center text-[#800000ff] mb-8">
        Themes for ANIMATE 2026
      </h2>

      <!-- Main Layout: Single Combined Image (Left) & Policy Info (Right) -->
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-center">
        
        <!-- Left Side: Single Combined Theme Poster Image (7 cols on Desktop) -->
        <div class="lg:col-span-7">
          <div class="overflow-hidden rounded-xl border border-gray-100 bg-gray-900 shadow-md transition-shadow hover:shadow-xl">
            <img 
              src={theme.src} 
              alt="ANIMATE 2026 Themes: A World Without, The Day After Tomorrow, One Small Idea" 
              decoding="async"
              class="h-auto w-full object-cover"
            />
          </div>
        </div>

        <!-- Right Side: Content & Rules (5 cols on Desktop) -->
        <div class="flex flex-col justify-center space-y-4 text-xl text-gray-800 lg:col-span-5 lg:pl-4">
          <p class="leading-relaxed">
            All three themes are open to both <strong>Synfig Studio</strong> and <strong>Blender</strong> participants.
          </p>

          <p class="leading-relaxed text-gray-700">
            Make them more story-driven and visually interesting.
          </p>

          <p class="text-base font-bold text-black">
            Use AI to imagine. Use Open Source to create.
          </p>

          <p class="text-black leading-relaxed">
            AI may assist with story, ideas, scripts, research and supporting tasks.
          </p>

          <!-- Icon Bullet Points -->
          <ul class="space-y-2.5 pt-2 text-xs font-medium text-black sm:text-xs">
            <li class="flex items-start gap-2.5">
              <span class="text-base leading-none">🚫</span>
              <span>No complete AI generated animations.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-base leading-none">🎬</span>
              <span>Final animation must be created in Synfig Studio or Blender.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-base leading-none">📝</span>
              <span>AI usage must be disclosed.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-base leading-none">✂️</span>
              <span>Creativity and human animation work will be judged.</span>
            </li>
          </ul>
        </div>

      </div>

    </div>
  </section>
</Main>