---
import Main from '../layouts/main.astro';
import eligibility from '../images/eligibility.png';
import { slide } from 'astro:transitions';
---

<Main>
<section id="about" class="bg-white py-12">
  <div class="mx-auto max-w-5xl px-6">
    <!-- Heading -->
    <h2 class="text-3xl font-bold text-center text-[#800000ff] mb-8">
      About 
    </h2>

    <!-- Description -->
    <div class="space-y-6 text-gray-700 leading-8">
      <p>
        <strong>ANIMATE 2026</strong> is an online Animation Hackathon using
        <strong>Synfig Studio (2D)</strong> and
        <strong>Blender (3D)</strong>, organized by
        <strong>FOSSEE, IIT Bombay</strong>. The FOSSEE project is part of the
        <strong>
          National Mission on Education through Information and Communication
          Technology (NMEICT)
        </strong>,
        Ministry of Education (MoE), Government of India.
      </p>

      <!-- Highlight -->
      <div class="rounded-lg border-l-4 border-[#800000ff] bg-[#fff7f7] p-5">
        <h3 class="text-xl font-bold text-[#800000ff] mb-2">
          Use AI to imagine. Use Open Source to create.
        </h3>
        <p class="font-semibold">
          AI is an Assistant — Not the Creator.
        </p>
      </div>

      <p>
        AI tools are permitted in <strong>ANIMATE 2026</strong>, but they must
        be used only to assist the participant's creative process. The final
        animation must be created and animated by the participant using the
        approved open-source animation software.
      </p>

      <p class="font-semibold text-red-700">
        AI-generated content cannot replace the participant's animation work.
      </p>

      <!-- Approved Software -->
      <div class="rounded-xl bg-gray-50 p-6 border">
        <h3 class="text-2xl font-semibold text-[#800000ff] mb-4">
          Approved Animation Software
        </h3>

        <ul class="list-disc space-y-2 pl-6">
          <li><strong>2D Animation:</strong> Synfig Studio</li>
          <li><strong>3D / 2D Animation:</strong> Blender</li>
        </ul>
      </div>

      <!-- Supporting Tools -->
      <div class="rounded-xl bg-[#f9fdf4] p-6 border">
        <h3 class="text-2xl font-semibold text-[#800000ff] mb-4">
          FOCAL-Supported Open Source Tools
        </h3>

        <ul class="grid gap-3 sm:grid-cols-2">
          <li>🎨 <strong>Inkscape</strong> — Vector artwork and assets</li>
          <li>🖼️ <strong>GIMP</strong> — Image editing and textures</li>
          <li>🎙️ <strong>Audacity</strong> — Audio editing</li>
          <li>🎬 <strong>OpenShot</strong> — Video editing</li>
          <li>🎞️ <strong>Blender Video Editor</strong> — Video editing</li>
          <li>💻 Any other open-source software only</li>
        </ul>
      </div>

      <!-- Judging -->
      <div class="rounded-lg border border-green-300 bg-green-50 p-6">
        <h3 class="text-xl font-semibold text-green-800 mb-2">
          Judging Criteria
        </h3>

        <p>
          We evaluate the participant's <strong>creativity</strong>,
          <strong>animation skills</strong>,
          <strong>storytelling</strong>, and effective
          <strong>use of open-source software</strong>—not the quality of an
          AI-generated video.
        </p>
      </div>
    </div>
  </div>
</section>

<section id="eligibility" class="bg-white py-12">
    <div class="mx-auto max-w-6xl px-6">
      
      <!-- Top Grid: Heading & Image -->
      <div class="grid items-center gap-8 md:grid-cols-2">
        <div>
         <h2 class="text-3xl font-bold text-center text-[#800000ff] mb-8">
            Who Can Participate?
          </h2>
          <p class="mt-2 text-center text-gray-600">
            Open to creators, thinkers, and animators across all skill levels.
          </p>
        </div>
        
        <div class="flex justify-center md:justify-end">
          <img 
            src={eligibility.src} 
            alt="Welcome to Synfig Studio Hackathon" 
            decoding="async"
            class="max-h-64 w-auto object-contain"
            transition:animate={slide({ duration: '0.6s' })} 
          />
        </div>
      </div>

      <!-- Eligibility Highlights Grid -->
      <div class="mt-4 grid gap-6 sm:grid-cols-3">
        
        <!-- Entry Fee -->
        <div class="flex items-start gap-4 rounded-xl border border-gray-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-50 text-xl text-[#800000]">
            🏷️
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">No Entry Fee</h3>
            <p class="mt-1 text-sm text-gray-600">
              Participation in ANIMATE 2026 is completely free of charge.
            </p>
          </div>
        </div>

        <!-- Target Audience -->
        <div class="flex items-start gap-4 rounded-xl border border-gray-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-50 text-xl text-[#800000]">
            🎓
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">Open to All</h3>
            <p class="mt-1 text-sm text-gray-600">
              Students, freelancers, working professionals, and animation enthusiasts.
            </p>
          </div>
        </div>

        <!-- Team Structure -->
        <div class="flex items-start gap-4 rounded-xl border border-gray-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-50 text-xl text-[#800000]">
            👥
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">Solo or Teams</h3>
            <p class="mt-1 text-sm text-gray-600">
              Participate individually or assemble a team of up to 4 members.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>
  </Main>
