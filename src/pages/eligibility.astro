---
import Main from '../layouts/main.astro';
import eligibility from '../images/eligibility.png';
import { slide } from 'astro:transitions';
---

<Main>
  <section id="eligibility" class="bg-white py-12">
    <div class="mx-auto max-w-6xl px-6">
      
      <!-- Top Section: Centered Heading -->
      <div class="mb-8 w-full text-center">
        <h2 class="text-3xl font-bold text-[#800000ff]">
          Eligibility to Participate
        </h2>
      </div>

      <!-- Content Card -->
      <div class="mt-4 text-xl rounded-xl border border-green-300 bg-white p-6 shadow-sm">
        <ul class="space-y-4 text-gray-700">
          <li class="flex items-start gap-3">
            <span class="text-[#800000ff]">•</span>
            <span>The hackathon is open to all.</span>
          </li>
          
          <li class="flex items-start gap-3">
            <span class="text-[#800000ff]">•</span>
            <span>Participate as an individual or as a team (max. 4 members).</span>
          </li>
          
          <li class="flex items-start gap-3">
            <span class="text-[#800000ff]">•</span>
            <span>High school/college students, faculty, and professionals (animators, designers, etc.) from any field who are interested in creating animations.</span>
          </li>
          
          <li class="flex items-start gap-3">
            <span class="text-[#800000ff]">•</span>
            <span>Knowledge of basic graphics, designing, and animation is required.</span>
          </li>
          
          <li class="flex items-start gap-3">
            <span class="text-[#800000ff]">•</span>
            <span>
              Prior knowledge of using Synfig Studio to create 2D animation is expected. If you are self-motivated and want to participate, you can learn Synfig Studio using 
              <a 
                href="https://spoken-tutorial.org" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="font-medium text-blue-600 hover:underline"
              >
                Spoken Tutorials
              </a>. 
              These are available in English, Hindi, Kannada, Marathi, Malayalam, Tamil, and Telugu.
            </span>
          </li>
        </ul>
      </div>

    </div>
  </section>
</Main>