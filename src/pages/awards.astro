---
import Main from '../layouts/main.astro';
---

<Main title="Awards and Certificates" description="Awards and Certificates for Animate 2026">

  <section id="awards" class="bg-white py-12">
    <div class="mx-auto max-w-6xl px-6">

      <!-- Section Header -->
      <div class="mb-8 text-center">
        <h2 class="text-3xl font-bold text-[#800000ff] mb-2">
          Awards and Certificates
        </h2>
      </div>

      <!-- Awards Box -->
       <div class="rounded-lg border border-green-300 p-5 ">
        <h3 class="font-bold text-gray-900 mb-3 text-xl">🏆 Prize Money</h3>

        <ul class="list-disc pl-8 space-y-3 ">
          <li class="text-xl">First Prize: ₹5,000</li>
          <li class="text-xl">Second Prize: ₹3,000</li>
          <li class="text-xl">Third Prize: ₹2,000</li>
        </ul>

        <div class="mt-8 space-y-5">
          <p class="text-xl font-[Montserrat], sans-serif">
            💸 Prize money will be transferred online to each
            <strong>Team Lead's</strong> account.
          </p>

          <p class="text-xl font-[Montserrat], sans-serif">
            📜 All the team members under the Winners, Special categories
            and Consolation will be awarded with a Certificate of Achievement
            during the closing ceremony.
          </p>
        </div>

      </div>

    </div>
  </section>

</Main>