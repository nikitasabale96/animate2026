---
import Main from '../layouts/main.astro';
---

<Main title="Awards">
   <div class="flex flex-col md:flex-row pt-3 mt-10">
      <!-- heading on bottom of div -->
      <div class="w-full md:w-1/2 relative min-h-full">
        <div class="md:absolute bottom-0">
        <h1 class="section-title text-4xl pb-3 text-center ">Awards and Certificates
</h1>
      </div>
      </div>
        
        </div>
  <div class="mt-2 pt-2 text-base font-[Montserrat], sans-serif">
    <div class="col-span-3 p-4">
      <h1 class="justify-end text-2xl mb-4">🎬 3D Animation Submissions</h1>
      <ul style="list-style: circle;">
        <li class="text-xl">First Prize: ₹5,000</li>
        <li class="text-xl">Second Prize: ₹3,000</li>
        <li class="text-xl">Third Prize: ₹2,000</li>
        <li class="text-xl">Best School Submission: ₹2,500</li>
      </ul>
<br /><br />

      <h1 class="justify-end text-2xl mb-4">✏️ 2D Animation Submissions</h1>
      <ul style="list-style: circle;">
        <li class="text-xl">First Prize: ₹5,000</li>
        <li class="text-xl">Second Prize: ₹3,000</li>
        <li class="text-xl">Third Prize: ₹2,000</li>
        <li class="text-xl">Best School Submission: ₹2,500</li>
      </ul>
<br />
<br />

      <h1 class="justify-end text-2xl mb-4">🎖️ Consolation Prize:1000</h1>
      <!-- <ul style="list-style: circle;"> -->
        <!-- <li class="text-xl">₹1,000</li> -->
      <!-- </ul> -->
<!-- <br /> -->

      <!-- <p class="mt-6 text-xl text-base font-[Montserrat], sans-serif">💸 Prize money will be transferred online to each <strong class="text-purple-700">Team Lead's</strong> account.</p> -->
      <p class="mt-6 text-xl text-base font-[Montserrat], sans-serif">📜 All the team members under the Winners, Special categories and Consolation will be awarded with a Certificate of Achievement during the closing ceremony.</p>
    </div>
  </div>
</Main>
