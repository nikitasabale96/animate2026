---
import Main from '../layouts/main.astro';
import Hero from '../images/hero.png';
import logo from '../images/logo-2026.png';
import fos from '../images/fossee-logo.png';
import iit from '../images/IITB-logo.png';
// import regi from '../images/btn-01-a.png';
---

<Main>
<div
      
      class="lg:hidden sm:block rounded-t-lg mx-1 px-1" style="background:#ddea9afff;"
    >
      <!-- <nav> --> 
    <div class="flex flex-row align-items-center justify-center bottom-8" style="background-color:#ddea9afff" data-astro-cid-mmggtga4="">
    <div class="flex items-start justify-start float-start w-1/2" data-astro-cid-mmggtga4="">
    <a href="https://www.iitb.ac.in/" target="_blank">
    <img src={iit.src} alt="iitb" decoding="async" data-astro-cid-mmggtga4="" style="width: 100px;">
    </a>
    </div>
    <div class="flex justify-end items-end float-end w-1/2" data-astro-cid-mmggtga4="">
    <a href="https://fossee.in" target="_blank">
    <img class="float-end" src={fos.src} alt="fossee" decoding="async" data-astro-cid-mmggtga4="" style="width: 100px;">
    </a>
    </div>
    </div>
        <div class="grid my-auto grid-rows-1 sm:grid-rows-1">
          <div class="row-span-1"><div class="pt-5 flex items-center justify-center">
        
            <img  src={logo.src} alt="regi" decoding="async" />
          </div></div>
         
         
        </div>
        <!-- <div class="flex items-center justify-center"><ul class="">
          <li class="py-2 "><a href="/register">
      
            <img class="duration-300" src={regi.src} alt="regi" decoding="async" />
             <img src="../images/register.png" alt="Image 1" class="w-1/4 w-25"> -->
        
            
          <!-- </a></li> -->
        <!-- </ul></div> -->
        
<div class="flex justify-center">
  <a href="/register"
    class="relative inline-block px-6 py-3 font-bold text-white border border-[#38a169]
      rounded-lg overflow-hidden transition duration-300 ease-in-out mt-6 mb-10"
    style="
      background: rgba(56, 161, 105, 0.15);
      box-shadow:
        0 0 10px rgba(56, 161, 105, 0.8),
        0 0 20px rgba(47, 133, 90, 0.5),
        inset 0 0 5px rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(4px);
      text-shadow: 0 0 8px rgba(56, 161, 105, 0.9);
      color: #38a169;
    "
    onmouseover="
      this.style.boxShadow='0 0 20px rgba(47, 133, 90, 1), 0 0 40px rgba(56, 161, 105, 0.8), inset 0 0 10px rgba(56, 161, 105, 0.4)';
      this.style.textShadow='0 0 12px rgba(255, 255, 255, 1)';
      this.style.color='white';
      this.style.borderColor='#2f855a';
      this.style.backgroundColor='#2f855a';
    "
    onmouseout="
      this.style.boxShadow='0 0 10px rgba(56, 161, 105, 0.8), 0 0 20px rgba(47, 133, 90, 0.5), inset 0 0 5px rgba(255, 255, 255, 0.2)';
      this.style.textShadow='0 0 8px rgba(56, 161, 105, 0.9)';
      this.style.color='#38a169';
      this.style.borderColor='#38a169';
      this.style.backgroundColor='rgba(56, 161, 105, 0.15)';
    "
  >
    Register
  </a>
</div>        
        <div class="row-span-1 bg-red-500"> <div class="dates items-center" style="color:#0fe425"> 
          <!-- <p class="important-date flex items-center justify-center text-2xl md:text-center lg:text-2xl text-center"><strong> - Registrations are closed -</strong></p>
                <p class="important-date flex items-center justify-center text-2xl md:text-center lg:text-2xl text-center"><strong> - Last date of submission -</strong></p>
                <p class="important-date flex items-center justify-center text-2xl md:text-center lg:text-2xl"> 23 June 2024</p>                 -->
        </div></div>
      <!-- </nav> -->
    </div>
    <!-- Hero image -->
<!-- Hero image -->
  <section id="hero" class="relative w-full">
    <!-- Image -->
    <img 
      class="w-full object-cover p-2" 
      src={Hero.src} 
      alt="WELCOME TO SYNFIG STUDIO HACKATHON" 
      decoding="async" 
    />

    <!-- Text Patch Centered at Bottom of Hero -->
    <div
      class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2
             w-[85%] max-w-[700px]
             bg-[#333333]
             text-white
             rounded-2xl
             px-6 py-4
             justify-center content-center
             text-center
             shadow-lg z-10"
    >
      <p class="text-lg md:text-2xl lg:text-3xl font-medium leading-tight">
        Bring storytelling imagination to life with
        <span class="font-normal">
          Synfig Studio, Blender,
        </span>
        and the spark of AI.
      </p>
    </div>
  </section>

   
</Main>