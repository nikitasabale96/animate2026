<div class="mt-6 flex justify-center">
  <a href="/register" class="custom-register-btn">
    Register
  </a>
</div>

<style>
  .custom-register-btn {
    display: inline-block;
    border-radius: 0.375rem; /* rounded-md */
    background-color: #38a169;
    padding: 0.625rem 2rem; /* px-8 py-2.5 */
    font-size: 1.25rem; /* text-xl */
    font-weight: 700; /* font-bold */
    color: #ffffff;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    transition: all 0.2s ease-in-out;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent; /* Removes default grey tap overlay on mobile */
    user-select: none;
  }

  /* Desktop hover state (only triggers on devices with an actual mouse cursor) */
  @media (hover: hover) {
    .custom-register-btn:hover {
      background-color: #2f855a;
      transform: scale(1.05);
    }
  }

  /* Mobile tap/touch active state */
  .custom-register-btn:active {
    background-color: #2f855a;
    transform: scale(0.95);
  }
</style>
        <div class="row-span-1 bg-red-500"> <div class="dates items-center" style="color:#0fe425"> 
